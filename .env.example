# Copy to .env in this folder (git and docker ignore it) and fill in what you use.
# delyrism loads it when the package is imported. Variables already set in the
# process environment (Railway, docker run -e) take precedence.
# Keep these out of the Windows User environment, which every program inherits.

# Cloudflare Workers AI: embedders, story writer, speech to text
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Cloudflare AI Gateway
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_GATEWAY_TOKEN=

# Gemini embedder (the hosted site's audio and image tower)
GEMINI_API_KEY=
